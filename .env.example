# SharkPay dev stack — environment defaults.
#
#   cp .env.example .env    # then edit; docker compose reads .env automatically
#
# Every value here is a DEV-ONLY default (secrets are fake by design; the
# Keycloak realm JSON and postgres init script ship the same literals, so
# the stack is consistent out of the box). NEVER commit .env (already
# git-ignored) and NEVER reuse any of these outside localhost.
#
# Compose never REQUIRES .env: every variable below also has an identical
# inline default in docker-compose.yml. Changing a Postgres role password
# only takes effect on a fresh volume (see docs/DEV-STACK.md § Volume reset).

# ── Postgres 18 (postgres:18-alpine) ─────────────────────────────────────
POSTGRES_USER=sharkpay                      # cluster superuser (dev only)
POSTGRES_PASSWORD=sharkpay-dev
POSTGRES_DB=sharkpay                        # shared DB; one schema per service

# Per-service LOGIN roles + passwords, created by
# infrastructure/dev/postgres/init/01-schemas.sql on first volume init.
# Each role owns exactly one schema (search_path pinned) — grant isolation
# per services/README.md. Schemas for payments/payouts/api_gateway/
# reconciliation are pre-created for the Wave 3 services.
LEDGER_DB_USER=sharkpay_ledger
LEDGER_DB_PASSWORD=ledger-dev-pass
IDENTITY_DB_USER=sharkpay_identity
IDENTITY_DB_PASSWORD=identity-dev-pass
WALLET_DB_USER=sharkpay_wallet
WALLET_DB_PASSWORD=wallet-dev-pass
RISK_DB_USER=sharkpay_risk
RISK_DB_PASSWORD=risk-dev-pass
FX_DB_USER=sharkpay_fx
FX_DB_PASSWORD=fx-dev-pass
PAYMENTS_DB_USER=sharkpay_payments
PAYMENTS_DB_PASSWORD=payments-dev-pass
PAYOUTS_DB_USER=sharkpay_payouts
PAYOUTS_DB_PASSWORD=payouts-dev-pass
API_GATEWAY_DB_USER=sharkpay_api_gateway
API_GATEWAY_DB_PASSWORD=api-gateway-dev-pass
RECONCILIATION_DB_USER=sharkpay_reconciliation
RECONCILIATION_DB_PASSWORD=reconciliation-dev-pass
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal-dev-pass

# ── Keycloak 26 (quay.io/keycloak/keycloak:26.3.3) ───────────────────────
# Master-realm bootstrap admin (http://localhost:8080/admin).
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-pass
KEYCLOAK_REALM=sharkpay

# Issuer used by the RESOURCE SERVERS (container-internal host). Spring
# services fetch OIDC discovery from the issuer URI, so it must be the
# in-network address http://keycloak:8080/realms/sharkpay.
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/sharkpay
# Issuer as seen from YOUR machine (browser login, token minting from the
# host — see docs/DEV-STACK.md § "Two issuer values").
KEYCLOAK_EXTERNAL_ISSUER=http://localhost:8080/realms/sharkpay

# Confidential service-client secrets (client_credentials grant). These
# MUST match the "secret" fields in
# infrastructure/dev/keycloak/sharkpay-realm.json.
KEYCLOAK_IDENTITY_CLIENT_SECRET=identity-service-dev-secret
KEYCLOAK_WALLET_CLIENT_SECRET=wallet-service-dev-secret
KEYCLOAK_RISK_CLIENT_SECRET=risk-service-dev-secret
KEYCLOAK_FX_CLIENT_SECRET=fx-service-dev-secret
KEYCLOAK_PAYMENTS_CLIENT_SECRET=payments-service-dev-secret
KEYCLOAK_PAYOUTS_CLIENT_SECRET=payouts-service-dev-secret
KEYCLOAK_API_GATEWAY_CLIENT_SECRET=api-gateway-service-dev-secret
KEYCLOAK_RECONCILIATION_CLIENT_SECRET=reconciliation-service-dev-secret

# Demo users in the sharkpay realm (dev-only passwords; see the realm JSON).
DEMO_OPS_PASSWORD=sharkpay-dev-ops
DEMO_MERCHANT_PASSWORD=sharkpay-dev-merchant
DEMO_AGENT_PASSWORD=sharkpay-dev-agent

# ── NATS 2.11 JetStream (nats:2.11-alpine) ───────────────────────────────
NATS_URL=nats://nats:4222

# ── Redis 7 (redis:7-alpine, cache only) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Ledger (Go, services/ledger) ─────────────────────────────────────────
# memory = dev-only fake store (default, no migrations needed).
# postgres = real store: apply services/ledger/migrations first, then flip
# this to postgres (docs/DEV-STACK.md § "Switching the ledger to Postgres").
LEDGER_STORE=memory
LEDGER_DATABASE_URL=postgres://sharkpay_ledger:ledger-dev-pass@postgres:5432/sharkpay?sslmode=disable
INTERNAL_API_TOKEN=dev-internal-token

# ── Providers gateway (Go, services/providers → WireMock HoneyCoin) ──────
HONEYCOIN_BASE_URL=http://wiremock:8080
HONEYCOIN_SIGNING_KEY=dev-honeycoin-key
HONEYCOIN_CALLBACK_SECRET=dev-callback-secret

# ── FX service tuning (services/fx/src/main/resources/application.yml) ───
FX_MARKUP_BPS=150
FX_QUOTE_TTL_SECONDS=30
FX_QUOTE_SWEEP_INTERVAL_MS=5000

# ── Observability (SEPARATE overlay, not in docker-compose.yml) ──────────
# The collector container comes from the observability workstream's compose
# overlay; services already receive this endpoint, so the overlay drops in
# without touching the root compose file.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── Container plumbing — read inside the containers, NOT settable here ────
# HEALTHCHECK_PORT (identity 8081 / wallet 8082 / fx 8083 / risk 8084) is
# set per-service by docker-compose.yml and expanded by the healthcheck
# probe INSIDE each container ($$-escaped — compose never interpolates it
# from this file). It always equals the service's server.port; do not try
# to override it via .env.
