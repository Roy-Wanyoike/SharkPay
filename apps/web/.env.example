# ─────────────────────────────────────────────────────────────────────────────
# SharkPay Web Console — environment (copy to .env.local for local dev)
# ─────────────────────────────────────────────────────────────────────────────

# Auth mode: "mock" (local dev without Keycloak) or "keycloak" (real OIDC).
# Unset defaults to "keycloak" (fail-safe).
AUTH_MODE=mock

# 32+ char secret used to AES-256-GCM encrypt the HttpOnly session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-openssl-rand-base64-32

# Keycloak OIDC (used when AUTH_MODE=keycloak).
# The dev realm is imported from infrastructure/dev/keycloak/sharkpay-realm.json
# (client "sharkpay-web", authorization code + PKCE S256, redirect
# http://localhost:3000).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=sharkpay
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=sharkpay-web

# API base URL — the api-gateway service (docker-compose.yml maps it to 8088).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088

# Environment badge shown in the topbar: "sandbox" or "prod".
NEXT_PUBLIC_ENV=sandbox
