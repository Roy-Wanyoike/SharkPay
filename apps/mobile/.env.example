# ─────────────────────────────────────────────────────────────────────────────
# SharkPay Mobile — environment (copy to .env.local for local dev)
#
# Expo only inlines variables prefixed EXPO_PUBLIC_* into the client bundle
# (they are PUBLIC by design — never put secrets here; the mobile client is a
# public OIDC client, PKCE only, no client secret).
# ─────────────────────────────────────────────────────────────────────────────

# SharkPay API base URL INCLUDING the version path (the servers block of
# contracts/openapi/v1/*.yaml). Local dev: the api-gateway container, which
# routes /v1/payments, /v1/payouts, /v1/wallets, /v1/transfers, /v1/fx.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8088/v1

# Keycloak OIDC (dev realm imported from
# infrastructure/dev/keycloak/sharkpay-realm.json — client "sharkpay-mobile",
# authorization code + PKCE S256, redirect sharkpay-mobile://callback).
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=sharkpay
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=sharkpay-mobile

# Optional: pin the OAuth redirect URI (defaults to the scheme-based
# sharkpay-mobile://callback on native builds, exp://… in Expo Go).
# EXPO_PUBLIC_AUTH_REDIRECT_URI=sharkpay-mobile://callback

# Environment badge shown in Settings: "sandbox" or "prod".
EXPO_PUBLIC_ENV=sandbox
