{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "ledger": {
      "root": "services/ledger",
      "runtime": "go"
    },
    "providers": {
      "root": "services/providers",
      "runtime": "go"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
