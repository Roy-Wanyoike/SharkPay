{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharkpay.dev/contracts/events/fx.v1.json",
  "title": "FX events (v1)",
  "description": "CloudEvents 1.0-aligned event envelopes for fx.quote.locked.v1 and fx.conversion.executed.v1 events published by the fx service to Kafka. Webhook fan-out reuses the same envelope and data with the unversioned catalog type names (fx.quote.locked, fx.conversion.executed) - see events.md.",
  "type": "object",
  "required": ["id", "type", "specversion", "source", "subject", "occurred_at", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique event id (UUID v7). Consumers dedupe on this value."
    },
    "type": {
      "type": "string",
      "description": "CloudEvents type; equals the Kafka topic name.",
      "enum": [
        "fx.quote.locked.v1",
        "fx.conversion.executed.v1"
      ]
    },
    "specversion": {
      "const": "1.0",
      "description": "CloudEvents specification version."
    },
    "source": {
      "const": "sharkpay/fx",
      "description": "CloudEvents source: the producing service."
    },
    "subject": {
      "type": "string",
      "pattern": "^(fxq|cnv)_[0-9A-Za-z]{20,}$",
      "description": "CloudEvents subject: the quote id (fx.quote.locked) or conversion id (fx.conversion.executed)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred (RFC 3339)."
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/quoteLockedData"
        },
        {
          "$ref": "#/$defs/conversionExecutedData"
        }
      ]
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "Integer-only money (docs/API-CONTRACTS.md 1.6).",
      "required": ["amount_minor", "currency", "exponent"],
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "type": "integer",
          "format": "int64"
        },
        "currency": {
          "type": "string",
          "enum": ["KES", "USD", "EUR", "GBP", "USDC", "USDT"]
        },
        "exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      }
    },
    "rate": {
      "type": "object",
      "description": "Exchange rate as quote-currency minor units per one base-currency unit, at the rate's own exponent - exact integer representation, never a float.",
      "required": ["value_minor", "exponent", "base_currency", "quote_currency"],
      "additionalProperties": false,
      "properties": {
        "value_minor": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        },
        "exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "base_currency": {
          "type": "string",
          "enum": ["KES", "USD", "EUR", "GBP", "USDC", "USDT"]
        },
        "quote_currency": {
          "type": "string",
          "enum": ["KES", "USD", "EUR", "GBP", "USDC", "USDT"]
        }
      }
    },
    "quoteLockedData": {
      "type": "object",
      "description": "Payload for fx.quote.locked.v1: a quote was locked (its TTL is being consumed).",
      "required": ["quote_id", "base_currency", "quote_currency", "rate", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^fxq_[0-9A-Za-z]{20,}$"
        },
        "base_currency": {
          "type": "string",
          "enum": ["KES", "USD", "EUR", "GBP", "USDC", "USDT"]
        },
        "quote_currency": {
          "type": "string",
          "enum": ["KES", "USD", "EUR", "GBP", "USDC", "USDT"]
        },
        "rate": {
          "$ref": "#/$defs/rate"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Lock expiry; expiry of a locked quote is a p1 incident."
        }
      }
    },
    "conversionExecutedData": {
      "type": "object",
      "description": "Payload for fx.conversion.executed.v1: the 4-leg conversion entry was posted atomically.",
      "required": ["conversion_id", "quote_id", "source_amount", "target_amount", "entry_id"],
      "additionalProperties": false,
      "properties": {
        "conversion_id": {
          "type": "string",
          "pattern": "^cnv_[0-9A-Za-z]{20,}$"
        },
        "quote_id": {
          "type": "string",
          "pattern": "^fxq_[0-9A-Za-z]{20,}$"
        },
        "source_amount": {
          "$ref": "#/$defs/money"
        },
        "target_amount": {
          "$ref": "#/$defs/money"
        },
        "entry_id": {
          "type": "string",
          "format": "uuid",
          "description": "Ledger journal entry id of the 4-leg conversion posting."
        }
      }
    }
  },
  "examples": [
    {
      "id": "0192a7cd-9c0d-9e1f-9a2b-8c4d5e6f7a8b",
      "type": "fx.conversion.executed.v1",
      "specversion": "1.0",
      "source": "sharkpay/fx",
      "subject": "cnv_01HZWR4Z7K8Q2N5M9X3V1B6Y0A",
      "occurred_at": "2026-09-01T10:00:30Z",
      "data": {
        "conversion_id": "cnv_01HZWR4Z7K8Q2N5M9X3V1B6Y0A",
        "quote_id": "fxq_01HZWR4Z7K8Q2N5M9X3V1B6Y0A",
        "source_amount": {
          "amount_minor": 15000000,
          "currency": "KES",
          "exponent": 2
        },
        "target_amount": {
          "amount_minor": 1157900,
          "currency": "USD",
          "exponent": 2
        },
        "entry_id": "0192a7ce-0d1e-9f2a-9b3c-8d5e6f7a8b9c"
      }
    }
  ]
}
