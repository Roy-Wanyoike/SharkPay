# EXAMPLE ONLY — copy to <svc>.env (git-ignored) and fill real values.
# Never commit real values; the .env files live outside git.
# Create the in-cluster Secret per service with:
#   kubectl -n sharkpay create secret generic payouts-secrets --from-env-file=payouts.env
PAYOUTS_DB_URL=jdbc:postgresql://postgres.sharkpay-postgres.svc:5432/sharkpay_payouts
PAYOUTS_DB_USER=REPLACE_ME
PAYOUTS_DB_PASSWORD=REPLACE_ME
