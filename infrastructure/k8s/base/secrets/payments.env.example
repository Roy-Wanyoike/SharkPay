# EXAMPLE ONLY — copy to <svc>.env (git-ignored) and fill real values.
# Never commit real values; the .env files live outside git.
# Create the in-cluster Secret per service with:
#   kubectl -n sharkpay create secret generic payments-secrets --from-env-file=payments.env
PAYMENTS_DB_URL=jdbc:postgresql://postgres.sharkpay-postgres.svc:5432/sharkpay_payments
PAYMENTS_DB_USER=REPLACE_ME
PAYMENTS_DB_PASSWORD=REPLACE_ME
