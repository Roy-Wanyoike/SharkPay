# EXAMPLE ONLY — copy to <svc>.env (git-ignored) and fill real values.
# Never commit real values; the .env files live outside git.
# Create the in-cluster Secret per service with:
#   kubectl -n sharkpay create secret generic ledger-secrets --from-env-file=ledger.env
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@postgres.sharkpay-postgres.svc:5432/sharkpay?sslmode=require
INTERNAL_API_TOKEN=REPLACE_ME_INTERNAL_API_TOKEN
