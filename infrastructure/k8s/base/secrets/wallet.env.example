# EXAMPLE ONLY — copy to <svc>.env (git-ignored) and fill real values.
# Never commit real values; the .env files live outside git.
# Create the in-cluster Secret per service with:
#   kubectl -n sharkpay create secret generic wallet-secrets --from-env-file=wallet.env
WALLET_DB_URL=jdbc:postgresql://postgres.sharkpay-postgres.svc:5432/sharkpay_wallet
WALLET_DB_USER=REPLACE_ME
WALLET_DB_PASSWORD=REPLACE_ME
