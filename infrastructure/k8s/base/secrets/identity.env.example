# EXAMPLE ONLY — copy to <svc>.env (git-ignored) and fill real values.
# Never commit real values; the .env files live outside git.
# Create the in-cluster Secret per service with:
#   kubectl -n sharkpay create secret generic identity-secrets --from-env-file=identity.env
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.sharkpay-postgres.svc:5432/sharkpay
SPRING_DATASOURCE_USERNAME=REPLACE_ME
SPRING_DATASOURCE_PASSWORD=REPLACE_ME
